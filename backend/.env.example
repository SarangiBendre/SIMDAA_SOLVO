# ==========================================================
# SIMDAA SOLVO - Backend Environment Configuration
# Copy this file to .env and adjust values for your setup.
#
# SECURITY: this is a TEMPLATE. Never put real secrets in this file
# - it's meant to be committed to git. Put real values only in your
# local .env (already gitignored) or in your hosting platform's
# environment variable settings (e.g. Render dashboard).
# ==========================================================

# ---- Database ----
# Default: local SQLite file, works with zero setup.
DATABASE_URL=sqlite:///./simdaa_solvo.db
#
# SQL Server (matches the original desktop dev setup):
# DATABASE_URL=mssql+pyodbc://@YOUR_SERVER/SIMDAA_SOLVO?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
#
# PostgreSQL (e.g. Neon):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/simdaa_solvo

# ---- Auth ----
# Generate your own random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the value that used to ship here as an example - treat it as burned.
JWT_SECRET_KEY=replace-with-your-own-random-secret
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- Default admin account (seeded automatically on first run) ----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin@123
DEFAULT_ADMIN_EMAIL=admin@simdaasolvo.local

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email notifications ----
EMAIL_NOTIFICATIONS_ENABLED=true

# Recommended, especially if deploying to Render, Railway, or similar:
# Brevo's HTTP API sends over HTTPS (port 443), which cloud platforms
# never block - unlike raw SMTP (see SMTP_* below), which many free
# hosting tiers block outright. Get this from Brevo > Settings > SMTP &
# API > API Keys tab (NOT the SMTP key/password - a different value).
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=SIMDAA SOLVO

# Fallback / local-development option: plain SMTP. Works fine on your
# own machine and most non-free hosts, but many free-tier cloud
# platforms (e.g. Render's free web services) block ports 25/465/587
# entirely, so this will silently stop working once deployed there -
# use BREVO_API_KEY above instead if that happens.
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# ---- AI Assistant ----
# Leave AI_PROVIDER=none to use the built-in keyword/similarity engine only
# (no external calls, works out of the box). Set it to turn on a real LLM
# that reads the matched Knowledge Base entries and drafts a suggestion:
#
#   AI_PROVIDER=openai   -> needs OPENAI_API_KEY (get one at platform.openai.com)
#   AI_PROVIDER=gemini   -> needs GEMINI_API_KEY (get one at aistudio.google.com)
#   AI_PROVIDER=ollama   -> needs a local Ollama server running (free, self-hosted)
AI_PROVIDER=none

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# Must be a real, current Gemini model name - check
# https://ai.google.dev/gemini-api/docs/models if unsure. Google
# retires/renames these fairly often (e.g. gemini-2.0-flash was
# retired June 2026).
GEMINI_MODEL=gemini-3.5-flash

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
